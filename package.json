{
  "name": "hajicli-monorepo",
  "version": "1.5.0",
  "private": true,
  "license": "MIT",
  "description": "A lightweight terminal AI helper CLI tool",
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "build": "tsc --build && node scripts/postbuild.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:full": "pnpm run build && pnpm run build:native",
    "bench:native": "node scripts/benchmark-terminal-engine.mjs",
    "ab:report": "node scripts/ab-report.mjs",
    "ab:extract": "node scripts/ab-extract.mjs",
    "shot": "node scripts/shot.mjs",
    "clean": "tsc --build --clean",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "pnpm run build && node --test packages/cli/test/*.test.mjs",
    "check": "pnpm lint && pnpm test",
    "pack:check": "pnpm run build:full && node scripts/verify-packages.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
