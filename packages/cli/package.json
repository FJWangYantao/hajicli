{
  "name": "hajicli",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Interactive CLI terminal frontend for hajicli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FJWangYantao/hajicli.git",
    "directory": "packages/cli"
  },
  "author": "TaoCaptain",
  "keywords": [
    "cli",
    "ai",
    "assistant",
    "terminal",
    "tui",
    "agent"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.18.1"
  },
  "bin": {
    "haji": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "build:native": "node ../../scripts/build-native.mjs",
    "build:full": "pnpm run build && pnpm run build:native",
    "test": "tsc --build ../.. && node --test test/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@hajicli/core": "workspace:^",
    "@hajicli/plugins": "workspace:^"
  }
}
